<testdefinition version="1.0">
   <suite name="jolla-gallery-tests" domain="ui">
       <description>Jolla Gallery Application automatic tests</description>
       <set name="unit-tests" feature="Jolla Gallery">
           <description>QML component unit tests</description>
           <pre_steps>
               <step>/usr/sbin/mcetool -jdisabled -Doff -B1 -jenabled -U -B1 -kunlocked</step>
           </pre_steps>
           <case manual="false" name="GridPage">
               <step>cd /opt/tests/jolla-gallery/auto/ &amp;&amp; ./run-tests.sh tst_gridpage.qml</step>
           </case>
           <case manual="false" name="StartPage">
               <step>cd /opt/tests/jolla-gallery/auto/ &amp;&amp; ./run-tests.sh tst_startpage.qml</step>
           </case>
           <post_steps>
               <step>/usr/sbin/mcetool -jdisabled -Doff</step>
           </post_steps>
       </set>
   </suite>
</testdefinition>
