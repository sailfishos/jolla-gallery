[Desktop Entry]
Type=Application
Name=Gallery
X-MeeGo-Logical-Id=gallery-ap-name
X-MeeGo-Translation-Catalog=gallery
Icon=icon-launcher-gallery
Exec=/usr/bin/sailjail -p jolla-gallery.desktop /usr/bin/jolla-gallery
Comment=Jolla Gallery
MimeType=image/jpeg;image/png;image/gif;image/tiff;image/webp;image/bmp;x-scheme-handler/rtsp;video/*;
X-Maemo-Service=com.jolla.gallery
X-Maemo-Object-Path=/com/jolla/gallery/ui
X-Maemo-Method=com.jolla.gallery.ui.openUrl

[X-Sailjail]
Permissions=UserDirs;MediaIndexing;Ambience;Privileged;Internet;Synchronization;RemovableMedia;Audio;Accounts
OrganizationName=com.jolla
ApplicationName=gallery
