<node name="/com/jolla/gallery/ui">
    <interface name="com.jolla.gallery.ui">

        <method name="openUrl">
            <arg direction="in" type="as" name="urls"/>
        </method>

        <method name="showImages">
            <arg direction="in" type="as" name="urls"/>
        </method>

        <method name="openFile">
            <arg direction="in" type="s" name="file"/>
        </method>

        <method name="editFile">
            <arg direction="in" type="s" name="file"/>
        </method>

        <method name="shareFile">
            <arg direction="in" type="s" name="file"/>
        </method>

        <method name="showPhotos" />

        <method name="showVideos" />

        <method name="showScreenshots" />

        <method name="playVideoStream">
            <arg direction="in" type="as" name="url"/>
        </method>
   </interface>
</node>

